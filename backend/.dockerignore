# Keep the build context to what the Dockerfile actually copies. Without this
# a locally built ./pocketbase binary (~50 MB) and the live data directory ride
# along into every backend build. tests/ is deliberately NOT excluded: the image
# build runs `go test ./...`, and pdf_render_test.go resolves tests/pdf_render.cjs
# whenever FANGJI_PDF_RENDER=1.
pocketbase
pb_data/
coverage.out
coverage.html
.git/
*.md
